# Required. Create a new token through @BotFather; never commit the real value.
TELEGRAM_BOT_TOKEN=replace-me

# Optional. If omitted, Google Sheets statistics are disabled.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Лист1

# Optional inline service-account JSON. Prefer GOOGLE_APPLICATION_CREDENTIALS
# locally, or a secret-file mount / workload identity in production.
GOOGLE_CREDENTIALS_JSON=
